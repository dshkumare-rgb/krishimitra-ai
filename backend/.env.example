# Server Config
PORT=5000

# MongoDB URI (leave blank to run in mock JSON database mode)
MONGO_URI=mongodb://localhost:27017/krishimitra

# Google Gemini API Key (leave blank to run in simulated AI mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration (Optional - for token verification in production)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# FIREBASE_PRIVATE_KEY="your_firebase_private_key"
